{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beamjoy-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Secrets and vars set in the Cloudflare dashboard (AUTH_SECRET, OAuth credentials,
  // ADMIN_USER_IDS, ...) survive `wrangler deploy` instead of being wiped.
  "keep_vars": true,
  // Non-secret config only. Secrets (AUTH_SECRET, AUTH_DISCORD_ID/SECRET) are set in the dashboard
  // or with `wrangler secret put`.
  "vars": {
    // Auth.js only trusts the request host on Vercel by default.
    "AUTH_TRUST_HOST": "true"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by OpenNext; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "beamjoy-web"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beamjoy-web-db",
      // Every Cloudflare resource for this site shares the `beamjoy-web-` prefix.
      "database_id": "29ce5a34-2b43-4ab8-ba0a-910768c4c44f",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      // General-purpose file storage for the site. Each use gets its own key prefix
      // (route screenshots live under `screenshots/`).
      "binding": "STORAGE",
      "bucket_name": "beamjoy-web-storage"
    }
  ],
  "observability": {
    "enabled": true
  }
}
