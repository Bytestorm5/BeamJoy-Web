# Local development with `next dev`: copy to .env.local.
# In production these are Worker secrets/variables (dashboard or `wrangler secret put`);
# wrangler.jsonc has keep_vars on, so deploys never wipe them.

# Required by Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Discord sign-in: https://discord.com/developers/applications
# (redirect: <site>/api/auth/callback/discord)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Name-only login for local testing. Ignored in production builds.
AUTH_DEV_LOGIN=true

# Comma-separated user ids (e.g. discord:1234) allowed to edit/delete any route.
ADMIN_USER_IDS=

# Optional: public URL of the beamjoy-web-storage R2 bucket (r2.dev or a custom domain). When
# unset, screenshots are served through the Worker at /uploads/...
STORAGE_PUBLIC_URL=
