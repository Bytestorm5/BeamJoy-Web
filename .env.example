# Copy to .env.local for local development.

# Required by Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Needed when not deployed on Vercel (self-hosting / local).
AUTH_TRUST_HOST=true

# Sign-in providers: each one turns on once its credentials are set.
# Discord: https://discord.com/developers/applications (redirect: <site>/api/auth/callback/discord)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# GitHub: https://github.com/settings/developers (redirect: <site>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Local-only name-based login for testing. Ignored in production builds.
AUTH_DEV_LOGIN=true

# Comma-separated user ids (e.g. discord:1234) allowed to edit/delete any route.
ADMIN_USER_IDS=

# Database: a local SQLite file by default. In production use libSQL/Turso:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
DATABASE_URL=file:.data/beamjoy.db

# Screenshot storage: local disk by default; set this to use Vercel Blob instead.
BLOB_READ_WRITE_TOKEN=
# UPLOAD_DIR=.data/uploads
